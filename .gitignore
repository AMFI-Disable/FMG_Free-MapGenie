# ==============================================================================
# FMG (Free-MapGenie) .gitignore
# ==============================================================================
# Controls file visibility and repository hygiene:
# - Hides transient build artifacts, machine-specific caches, editor states, and secrets.
# - Preserves active working files, configuration definitions, and distribution assets.
# ==============================================================================

# ==============================================================================
# SECTION 1: WORKING & PRESERVED FILES (Explicit Whitelists)
# (Guarantees vital project sources, configs, and assets are preserved)
# ==============================================================================

# Core Project Configuration
!package.json
!yarn.lock
!tsconfig*.json
!wxt.config.ts
!manifest.json
!playwright.config.ts
!.editorconfig
!.nvmrc
!.prettierrc
!.prettierignore
!.gitignore

# Documentation & Licensing
!readme*.md
!changelog.md
!license

# Working Source Trees
!src/
!modules/
!icons/
!font/
!assets/
!public/
!popup/
!e2e/

# Whitelist VS Code Workspace Recommendations
!.vscode/extensions.json

# ==============================================================================
# SECTION 2: HIDDEN & IGNORED ARTIFACTS
# (Local caches, intermediate builds, user states, credentials, diagnostics)
# ==============================================================================

# ------------------------------------------------------------------------------
# 2.1 macOS System & Volume Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
.ds_store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Icon?

# ------------------------------------------------------------------------------
# 2.2 Package Managers & Dependencies
# ------------------------------------------------------------------------------
node_modules/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 2.3 Bundler, Build Products & Tooling Caches
# ------------------------------------------------------------------------------
.wxt/
.output/
.icons/
.cache/
dist/
build/
stats.html
stats-*.json
web-ext.config.ts
src/common/icons.ts

# ------------------------------------------------------------------------------
# 2.4 Testing, E2E & Playwright Artifacts
# ------------------------------------------------------------------------------
playwright/
playwright-report/
test-results/

# ------------------------------------------------------------------------------
# 2.5 Local Research, Scratchpads & Notes
# ------------------------------------------------------------------------------
research/
task.md
todo.md
plan.md
report.md
docs/internal/
*.tmp
*.temp
*.bak
tmp/
temp/
scratch/

# ------------------------------------------------------------------------------
# 2.6 Environment Secrets, Private Keys & Tokens
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.key
*.pem
*.token
credentials.json
token.json
*secret*

# ------------------------------------------------------------------------------
# 2.7 Diagnostics & Logs
# ------------------------------------------------------------------------------
*.log
logs/

# ------------------------------------------------------------------------------
# 2.8 IDEs, Text Editors & AI Agent Working Contexts
# ------------------------------------------------------------------------------
.vscode/*
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.gemini/
.claude/
.cursor/
.windsurf/
.codex/
antigravity.json
.nodeterm/
